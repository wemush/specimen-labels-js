{
  "format": "wols-interop-matrix",
  "formatVersion": 1,
  "wolsVersion": "1.3.0",
  "description": "Cross-implementation round-trip matrix. A generator encrypts every case and writes a corpus of decrypt/decryptFields cases (same shape as the conformance vectors); every other implementation must decrypt each corpus case and recover the input exactly.",
  "specSection": "QR Code Encoding > Encrypted Format",
  "conventions": {
    "operation": "encrypt = whole-label encrypted URL; encryptFields = field-level encryption of an embedded label",
    "secret": "{kdf: 'pbkdf2', passphrase, decryptPassphrase?} or {kdf: 'raw', keyBase64url}. decryptPassphrase, when present, is a different Unicode spelling (NFC vs NFD) of passphrase that must derive the same key.",
    "iterations": "PBKDF2 iterations to request. Absent for kdf=pbkdf2 means the generator's own default.",
    "sig": "Opaque value to attach as the URL's sig parameter. Decoders must return it unchanged; it is not verified."
  },
